<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="cn.xanderye.android.jdck">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
            android:allowBackup="true"
            android:icon="@drawable/ic_chem"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_chem"
            android:supportsRtl="true"
            android:theme="@style/Theme.JDCK"
            android:testOnly="false">
        <activity
                android:name=".activity.MainActivity"
                android:exported="true"
                android:alwaysRetainTaskState="true"
                android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|colorMode"/>
        <activity
                android:name=".activity.LoginActivity"
                android:label="@string/ql_login_name"
                android:exported="true"
                android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>

</manifest>